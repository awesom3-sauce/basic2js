10 REM GW-BASIC dialect extension: sequential file I/O (OPEN/CLOSE/PRINT #/INPUT #/EOF())
20 OPEN "NAMES.TXT" FOR OUTPUT AS #1
30 PRINT #1, "ADA"
40 PRINT #1, "GRACE"
50 CLOSE #1
60 OPEN "NAMES.TXT" FOR APPEND AS #1
70 PRINT #1, "ALAN"
80 CLOSE #1
90 OPEN "NAMES.TXT" FOR INPUT AS #1
100 WHILE NOT EOF(1)
110   INPUT #1, N$
120   PRINT "READ: "; N$
130 WEND
140 CLOSE #1
150 PRINT "DONE"
160 END
