10 RANDOMIZE 42
20 LET N = INT(RND(1) * 100) + 1
30 LET TRIES = 0
40 PRINT "GUESS A NUMBER BETWEEN 1 AND 100"
50 INPUT "YOUR GUESS"; G
60 LET TRIES = TRIES + 1
70 IF G = N THEN GOTO 100
80 IF G < N THEN PRINT "TOO LOW" ELSE PRINT "TOO HIGH"
90 GOTO 50
100 PRINT "CORRECT! YOU GOT IT IN"; TRIES; "TRIES"
110 END
